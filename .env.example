# 이 파일을 .env로 복사해서 값을 채우세요. (.env는 git에 올라가지 않습니다)
#   cp .env.example .env
#
# docker compose와 백엔드 로컬 실행(./gradlew bootRun)이 이 파일을 같이 씁니다.
# 값에는 따옴표를 붙이지 마세요.

# ---------- PostgreSQL ----------
POSTGRES_DB=manufacturing_dashboard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# ---------- JWT (필수) ----------
# 32자 이상 무작위 문자열. 예: openssl rand -base64 48
JWT_SECRET=

# ---------- 배포 주소 ----------
# 프론트엔드에 접속하는 주소를 쉼표로 구분해 적습니다. (웹소켓 출처 검사에 사용)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173

# ---------- InfluxDB 3 (선택) ----------
# 시계열 저장을 쓸 때만 주석을 풀고 채우세요.
# INFLUXDB_URL=http://localhost:8181
# INFLUXDB_TOKEN=
# INFLUXDB_DATABASE=factory

# ---------- 프론트엔드 빌드 (선택) ----------
# 외부 날씨 카드용 OpenWeather API 키
# VITE_OPENWEATHER_API_KEY=

# ---------- 배포 (deploy.yml로 EC2에 올릴 때) ----------
# Docker Hub에 올린 이미지 이름 앞부분 (예: myname → myname/factory-backend)
# DOCKER_HUB_USERNAME=
