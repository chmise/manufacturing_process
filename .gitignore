# ==== BUILD & DEPENDENCY FILES ====
# Gradle
.gradle/
**/build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/
gradle.properties*

# Node.js
**/node_modules
*-debug.log*
*-error.log*
.pnpm-debug.log*

# Python )
*.pyc
*.pyo
__pycache__/

# ==== APPLICATION SPECIFIC ====
# Spring Boot Backend
# application.properties는 비밀값 없이 환경변수만 참조하므로 git에 올린다.
# 개인 설정은 application-local.properties에 두면 올라가지 않는다.
dashboard_backend/src/main/resources/application-local.properties
dashboard_backend/out/
dashboard_backend/bin/
!**/src/main/**/bin/
!**/src/test/**/bin/

# React Frontend
dashboard_frontend/dist/
dashboard_frontend/build/
dashboard_frontend/.env*
!dashboard_frontend/.env.example

# 전역 패키지 파일 (기존 유지)



